// Ships the logs of Kuturl's containers to Loki, labelled with the Compose service name
// (service="kuturl", "kuturl-redis", ...), which is what OpsPilot's log search filters on.

discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "kuturl" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "kuturl.*"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}
}

loki.source.docker "kuturl" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.relabel.kuturl.output
	relabel_rules = discovery.relabel.kuturl.rules
	forward_to    = [loki.write.local.receiver]
}

loki.write "local" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
