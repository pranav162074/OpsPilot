# Copy this file to .env and adjust. Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Matches docker-compose.yml (host ports 5433 and 6380)
DATABASE_URL=postgresql+asyncpg://opspilot:opspilot@localhost:5433/opspilot
REDIS_URL=redis://localhost:6380/0

# Needed to create workspaces (POST /v1/workspaces). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave unset to switch workspace creation off.
ADMIN_TOKEN=

API_RATE_LIMIT_PER_MINUTE=120
WORKSPACE_CREATE_LIMIT_PER_HOUR=10

# Celery's queue (a separate Redis database from the app's)
CELERY_BROKER_URL=redis://localhost:6380/1

MAX_DOCUMENT_BYTES=1000000
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
INGESTION_MAX_ATTEMPTS=3
INGESTION_STALE_SECONDS=600
INGESTION_REQUEUE_AFTER_SECONDS=120

# Embeddings: "hashing" works offline with no key (word overlap only, for tests and CI);
# "gemini" uses Google's embedding model. Get a free key at https://aistudio.google.com/apikey
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_KEY=
QUERY_EMBEDDING_CACHE_SECONDS=86400

# Search: candidates per retriever before fusion, and the Reciprocal Rank Fusion constant
SEARCH_CANDIDATES=50
RRF_K=60

# The investigation agent. Uses GEMINI_API_KEY (above); without it investigations return 503
# and everything else still works. Set LLM_PROVIDER=none to switch it off explicitly.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
AGENT_MAX_STEPS=6
AGENT_REFLECTION=true
AGENT_TIMEOUT_SECONDS=90
# "react" (one tool call at a time) or "plan" (evidence in parallel, then hypotheses, checked)
AGENT_STRATEGY=react
INCIDENT_AGENT_STRATEGY=plan
# Input + output tokens one investigation may spend (0 = no limit)
AGENT_TOKEN_BUDGET=60000
AGENT_MAX_PARALLEL_TOOLS=6
AGENT_TOOL_TIMEOUT_SECONDS=20
AGENT_MAX_HYPOTHESES=3
# Runs whose worker died are resumed from their last stage, this many runs in all
AGENT_MAX_ATTEMPTS=2
ACTION_WEBHOOK_TIMEOUT_SECONDS=10
INVESTIGATIONS_PER_HOUR=30

# New incidents at or above this severity get an investigation automatically:
# critical, high, medium, low, or none
AUTO_INVESTIGATE_SEVERITY=high

# Serve the MCP tools for AI assistants at /mcp (true/false)
MCP_ENABLED=true

# Telemetry integrations (Prometheus, Loki, GitHub). Tokens you give them are encrypted with
# this key. Generate one (keep it secret, and keep it: changing it makes stored tokens
# unreadable):
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATIONS_KEY=
# Integration URLs may be localhost/private addresses (a local Prometheus). Leave empty for
# the default: allowed except when ENVIRONMENT=production (protects against SSRF).
INTEGRATIONS_ALLOW_PRIVATE_URLS=
TELEMETRY_TIMEOUT_SECONDS=10
