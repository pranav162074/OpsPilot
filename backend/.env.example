# Copy this file to .env and adjust. Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Matches docker-compose.yml (host ports 5433 and 6380)
DATABASE_URL=postgresql+asyncpg://opspilot:opspilot@localhost:5433/opspilot
REDIS_URL=redis://localhost:6380/0

# Needed to create workspaces (POST /v1/workspaces). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave unset to switch workspace creation off.
ADMIN_TOKEN=

API_RATE_LIMIT_PER_MINUTE=120
WORKSPACE_CREATE_LIMIT_PER_HOUR=10
