# Copy this file to .env and adjust. Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Matches docker-compose.yml (host ports 5433 and 6380)
DATABASE_URL=postgresql+asyncpg://opspilot:opspilot@localhost:5433/opspilot
REDIS_URL=redis://localhost:6380/0

# Needed to create workspaces (POST /v1/workspaces). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave unset to switch workspace creation off.
ADMIN_TOKEN=

API_RATE_LIMIT_PER_MINUTE=120
WORKSPACE_CREATE_LIMIT_PER_HOUR=10

# Celery's queue (a separate Redis database from the app's)
CELERY_BROKER_URL=redis://localhost:6380/1

MAX_DOCUMENT_BYTES=1000000
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
INGESTION_MAX_ATTEMPTS=3
INGESTION_STALE_SECONDS=600
INGESTION_REQUEUE_AFTER_SECONDS=120

# Embeddings: "hashing" works offline with no key (word overlap only, for tests and CI);
# "gemini" uses Google's embedding model. Get a free key at https://aistudio.google.com/apikey
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_KEY=
QUERY_EMBEDDING_CACHE_SECONDS=86400

# Search: candidates per retriever before fusion, and the Reciprocal Rank Fusion constant
SEARCH_CANDIDATES=50
RRF_K=60

# The investigation agent. Uses GEMINI_API_KEY (above); without it investigations return 503
# and everything else still works. Set LLM_PROVIDER=none to switch it off explicitly.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
AGENT_MAX_STEPS=6
AGENT_REFLECTION=true
AGENT_TIMEOUT_SECONDS=90
INVESTIGATIONS_PER_HOUR=30
